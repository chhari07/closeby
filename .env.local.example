# Copy this file to .env.local and fill in real values there.
# .env.local is git-ignored — never commit real keys.

# --- Clerk (authentication) ---------------------------------------------
# From the Clerk dashboard > API Keys, for this project's instance.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# --- Firebase client SDK (browser) --------------------------------------
# From the Firebase console > Project settings > General > Your apps > SDK
# setup and configuration. Safe to expose to the browser (NEXT_PUBLIC_*).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin SDK (server only) -----------------------------------
# From Firebase console > Project settings > Service accounts > Generate
# new private key. NEVER commit the downloaded JSON or these values —
# server-only, read by src/lib/firebase/admin.ts.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# --- Anthropic (AI helpers, Step 2 of the roadmap) ----------------------
# From console.anthropic.com > API Keys. Server-only — read by
# src/lib/ai/client.ts, never sent to the browser. Every AI file imports
# "server-only" so this can't leak even by accident.
ANTHROPIC_API_KEY=
# Optional global kill switch (src/lib/ai/settings.ts) — set to "true" to
# turn every AI helper off instantly, no redeploy needed for the per-shop
# toggles. Leave unset/blank to leave AI on (subject to the aiSettings docs).
AI_DISABLED=
