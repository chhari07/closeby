# Copy this file to .env.local and fill in real values there.
# .env.local is git-ignored — never commit real keys.

# --- Clerk (authentication) ---------------------------------------------
# From the Clerk dashboard > API Keys, for this project's instance.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# --- Supabase (database + product photos) --------------------------------
# From the Supabase dashboard for this project.
# Project URL and the anon / publishable key: Project Settings > API (or the
# "Connect" button). Safe to expose to the browser (NEXT_PUBLIC_*) — the
# anon key can't read or write any table (RLS on, no policies).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role / secret key: Project Settings > API. SERVER ONLY — never
# prefix with NEXT_PUBLIC_. Used for product photo uploads (src/lib/supabase/admin.ts).
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection string: "Connect" button > Transaction pooler (port
# 6543), with your database password filled in. SERVER ONLY — used for
# every database read/write (src/lib/db/client.ts).
DATABASE_URL=

# --- Anthropic (AI helpers, Step 2 of the roadmap) ----------------------
# From console.anthropic.com > API Keys. Server-only — read by
# src/lib/ai/client.ts, never sent to the browser. Every AI file imports
# "server-only" so this can't leak even by accident.
ANTHROPIC_API_KEY=
# Only needed if your key is an org-wide key rather than one scoped to a
# workspace — the API then requires this header on every request. Find the
# id at console.anthropic.com > Settings > the workspace's settings page
# (in its URL, or "Workspace ID" in workspace settings). Leave blank if
# your key is already workspace-scoped.
ANTHROPIC_WORKSPACE_ID=
# Optional global kill switch (src/lib/ai/settings.ts) — set to "true" to
# turn every AI helper off instantly, no redeploy needed for the per-shop
# toggles. Leave unset/blank to leave AI on (subject to the aiSettings docs).
AI_DISABLED=
# --- OpenAI / ChatGPT (optional alternative to Anthropic) ---------------
# AI_PROVIDER=openai sends every AI helper to OpenAI instead of Claude
# (src/lib/ai/openai.ts). Key from platform.openai.com > API keys — needs
# API credits there; a ChatGPT Plus subscription does not cover the API.
AI_PROVIDER=
OPENAI_API_KEY=
# Optional, defaults to gpt-4.1 (see src/lib/ai/openai.ts before going cheaper)
OPENAI_MODEL=
