      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "SAFETY CHECKLIST\n\n☐ Finish Step 0 first\n☐ AI gets only small, narrow tools\n☐ User id comes from login, not AI\n☐ Changes go through approval\n☐ Check every AI answer\n☐ Outside text is information only\n☐ Limits: steps, size, daily cost\n☐ One log entry per run\n☐ Off switch for each AI helper\n☐ Owner can turn any helper off",
      "originalText": "SAFETY CHECKLIST\n\n☐ Finish Step 0 first\n☐ AI gets only small, narrow tools\n☐ User id comes from login, not AI\n☐ Changes go through approval\n☐ Check every AI answer\n☐ Outside text is information only\n☐ Limits: steps, size, daily cost\n☐ One log entry per run\n☐ Off switch for each AI helper\n☐ Owner can turn any helper off",
      "fontSize": 17,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "el203",
      "lineHeight": 1.25,
      "autoResize": true,
