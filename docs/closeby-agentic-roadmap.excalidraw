      "versionNonce": 324100191,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "MISSING FEATURES\n\n• Stock does not go down after an\n  order, so we can sell too much\n• No online payment\n• Order lists load everything at once\n• Nearby search can miss shops in\n  busy areas\n• Only an in-app sound, no other alerts",
      "originalText": "MISSING FEATURES\n\n• Stock does not go down after an\n  order, so we can sell too much\n• No online payment\n• Order lists load everything at once\n• Nearby search can miss shops in\n  busy areas\n• Only an in-app sound, no other alerts",
      "fontSize": 18,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "el53",
      "lineHeight": 1.25,
      "autoResize": true,
      "baseline": 18
    },
