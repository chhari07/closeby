      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "DANGEROUS (safety)\n\n• Private key saved in the project\n• A user can set their own order\n  price and total\n• Order status can be changed to\n  anything, in any order\n• Owner can make a shop live\n  without a check\n• No limit on repeated requests",
      "originalText": "DANGEROUS (safety)\n\n• Private key saved in the project\n• A user can set their own order\n  price and total\n• Order status can be changed to\n  anything, in any order\n• Owner can make a shop live\n  without a check\n• No limit on repeated requests",
      "fontSize": 18,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "el51",
      "lineHeight": 1.25,
      "autoResize": true,
      "baseline": 18
    },
