    {
      "id": "el206",
      "type": "text",
      "x": 745,
      "y": 4590.625,
      "width": 284.22235107421875,
      "height": 318.75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
