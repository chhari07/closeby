rules_version = '2';

// All Firestore WRITES go through server actions (src/actions/*) using the
// Admin SDK, which bypasses these rules. The client SDK is read-only so a
// user can never fake an order, price, status, role or shop status directly.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function shopIsLive(shopData) {
      return shopData.status == "live";
    }

    function ownsShop(shopId) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/shops/$(shopId)).data.ownerId == request.auth.uid;
    }

    // users/{uid} — read own profile only. Writes are server-only (role lives here).
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // localities — read-only reference data, seeded server-side.
    match /localities/{localityId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // shops/{shopId} — live shops are public; drafts are visible to their owner.
    match /shops/{shopId} {
      allow read: if shopIsLive(resource.data) || (isSignedIn() && resource.data.ownerId == request.auth.uid);
      allow write: if false;

      // shops/{shopId}/products/{productId}
      match /products/{productId} {
        allow read: if shopIsLive(get(/databases/$(database)/documents/shops/$(shopId)).data) ||
          ownsShop(shopId);
        allow write: if false;
      }
    }

    // orders/{orderId} — readable by the buyer and the shop owner, written by the server only.
    match /orders/{orderId} {
      allow read: if isSignedIn() &&
        (resource.data.buyerId == request.auth.uid || ownsShop(resource.data.shopId));
      allow write: if false;
    }

    // --- Step 2 (AI foundation) — all four are server (Admin SDK) writes
    // only. The client only ever reads, and only its own rows.

    // aiRuns/{runId} — one log entry per AI call; the caller can see their
    // own usage history, never anyone else's.
    match /aiRuns/{runId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // approvals/{approvalId} — AI-written drafts awaiting a human decision.
    match /approvals/{approvalId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // aiUsage/{userId_date} — the spend-limit counter. Doc id already
    // embeds the uid, but check the field too rather than parse the id.
    match /aiUsage/{usageId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // aiSettings/{helper or helper__shopId} — on/off + daily-limit config.
    // Shared reference data (any signed-in user can see whether a helper
    // is currently on), never client-writable — the owner toggle goes
    // through src/actions/ai.ts's setMyShopAiHelperEnabled.
    match /aiSettings/{settingsId} {
      allow read: if isSignedIn();
      allow write: if false;
    }
  }
}
